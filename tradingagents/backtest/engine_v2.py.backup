"""
回测引擎核心模块

提供策略回测的核心功能，包括：
- 指标计算
- 信号生成
- 交易模拟
- 绩效计算
"""

import pandas as pd
import numpy as np
from datetime import datetime, timedelta
from typing import Dict, List, Optional, Tuple, Any
from dataclasses import dataclass, field
import logging

logger = logging.getLogger(__name__)


@dataclass
class Trade:
    """交易记录"""
    trade_id: str
    symbol: str
    direction: str  # 'buy' or 'sell'
    price: float
    quantity: int
    amount: float
    timestamp: datetime
    commission: float
    slippage: float
    reason: str  # 交易原因（规则触发）
    pnl: float = 0.0  # 盈亏（卖出时计算）


@dataclass
class Position:
    """持仓信息"""
    symbol: str
    quantity: int
    avg_price: float
    current_price: float
    market_value: float
    pnl: float
    pnl_pct: float
    open_time: datetime
    highest_price: float = 0.0  # 最高价（用于移动止损）


@dataclass
class BacktestResult:
    """回测结果"""
    # 基础信息
    job_id: str
    strategy_id: str
    strategy_name: str
    
    # 时间范围
    start_date: datetime
    end_date: datetime
    
    # 资金曲线
    initial_capital: float
    final_capital: float
    
    # 收益指标
    total_return: float  # 总收益率
    annual_return: float  # 年化收益率
    benchmark_return: float  # 基准收益率
    
    # 风险指标
    max_drawdown: float  # 最大回撤
    max_drawdown_duration: int  # 最大回撤持续天数
    volatility: float  # 年化波动率
    
    # 风险调整收益
    sharpe_ratio: float  # 夏普比率
    sortino_ratio: float  # 索提诺比率
    calmar_ratio: float  # 卡玛比率
    
    # 交易统计
    total_trades: int  # 总交易次数
    winning_trades: int  # 盈利交易次数
    losing_trades: int  # 亏损交易次数
    win_rate: float  # 胜率
    avg_win: float  # 平均盈利
    avg_loss: float  # 平均亏损
    profit_factor: float  # 盈亏比
    max_consecutive_wins: int  # 最大连续盈利次数
    max_consecutive_losses: int  # 最大连续亏损次数
    
    # 持仓统计
    avg_holding_days: float  # 平均持仓天数
    max_positions: int  # 最大持仓数
    
    # 详细数据
    equity_curve: List[Dict] = field(default_factory=list)
    drawdown_curve: List[Dict] = field(default_factory=list)
    trade_list: List[Dict] = field(default_factory=list)
    position_history: List[Dict] = field(default_factory=list)


class BacktestEngine:
    """回测引擎"""
    
    def __init__(
        self,
        initial_capital: float = 1000000.0,
        commission_rate: float = 0.0003,
        slippage_rate: float = 0.001,
        stamp_duty: float = 0.001,
    ):
        """
        初始化回测引擎
        
        Args:
            initial_capital: 初始资金
            commission_rate: 手续费率
            slippage_rate: 滑点率
            stamp_duty: 印花税（仅卖出时收取）
        """
        self.initial_capital = initial_capital
        self.commission_rate = commission_rate
        self.slippage_rate = slippage_rate
        self.stamp_duty = stamp_duty
        
        # 运行时状态
        self.cash = initial_capital
        self.positions: Dict[str, Position] = {}
        self.trades: List[Trade] = []
        self.equity_curve: List[Dict] = []
        
        # 风控参数
        self.max_positions = 10
        self.max_single_position_pct = 0.3
        self.stop_loss_pct = 0.05
        self.take_profit_pct = 0.15
        self.trailing_stop_pct = 0.03
        self.max_daily_loss_pct = 0.03
        
        # 统计
        self.daily_pnl = 0.0
        self.daily_start_equity = initial_capital
    
    def reset(self):
        """重置回测状态"""
        self.cash = self.initial_capital
        self.positions = {}
        self.trades = []
        self.equity_curve = []
        self.daily_pnl = 0.0
        self.daily_start_equity = self.initial_capital
    
    def run_backtest(
        self,
        strategy: Dict,
        data: pd.DataFrame,
        start_date: datetime,
        end_date: datetime,
        backtest_mode: str = "indicator_driven",
    ) -> BacktestResult:
        """
        运行回测
        
        Args:
            strategy: 策略配置
            data: 股票数据（多股票）
            start_date: 开始日期
            end_date: 结束日期
            backtest_mode: 回测模式
        
        Returns:
            回测结果
        """
        logger.info(f"开始回测: {strategy['name']}, 模式: {backtest_mode}")
        
        # 重置状态
        self.reset()
        
        # 应用策略风控参数
        self._apply_risk_rules(strategy.get('risk_rules', {}))
        
        # 按日期迭代
        dates = pd.date_range(start_date, end_date, freq='B')  # 只取工作日
        
        for date in dates:
            # 检查每日止损
            if self.daily_pnl < -self.max_daily_loss_pct * self.daily_start_equity:
                logger.warning(f"触发每日止损，跳过当天交易: {date}")
                continue
            
            # 获取当天数据
            daily_data = data[data['date'] == date]
            
            if daily_data.empty:
                continue
            
            # 1. 持仓检查（止损、止盈、移动止损）
            self._check_positions(daily_data, date)
            
            # 2. 生成买入信号
            buy_signals = self._generate_signals(
                strategy, daily_data, 'entry', date
            )
            
            # 3. 执行买入
            for signal in buy_signals:
                self._execute_buy(signal, daily_data, date)
            
            # 4. 更新净值
            self._update_equity(daily_data, date)
            
            # 5. 重置日内统计
            if date.weekday() == 4:  # 周五重置
                self.daily_pnl = 0.0
                self.daily_start_equity = self._calculate_equity(daily_data)
        
        # 计算绩效
        result = self._calculate_performance(
            strategy, start_date, end_date
        )
        
        logger.info(f"回测完成: 总收益率 {result.total_return:.2%}")
        
        return result
    
    def _apply_risk_rules(self, risk_rules: Dict):
        """应用风控规则"""
        if not risk_rules:
            return
        
        self.max_positions = risk_rules.get('max_positions', 10)
        self.stop_loss_pct = risk_rules.get('stop_loss', 0.05)
        self.take_profit_pct = risk_rules.get('take_profit', 0.15)
        self.trailing_stop_pct = risk_rules.get('trailing_stop', 0.03)
        self.max_daily_loss_pct = risk_rules.get('max_daily_loss', 0.03)
    
    def _check_positions(self, daily_data: pd.DataFrame, date: datetime):
        """检查持仓（止损、止盈、移动止损）"""
        positions_to_close = []
        
        for symbol, position in self.positions.items():
            # 获取当前价格
            stock_data = daily_data[daily_data['symbol'] == symbol]
            if stock_data.empty:
                continue
            
            current_price = stock_data['close'].iloc[0]
            position.current_price = current_price
            
            # 更新最高价
            if current_price > position.highest_price:
                position.highest_price = current_price
            
            # 计算盈亏
            position.pnl = (current_price - position.avg_price) * position.quantity
            position.pnl_pct = (current_price - position.avg_price) / position.avg_price
            
            # 检查止损
            if position.pnl_pct <= -self.stop_loss_pct:
                positions_to_close.append((symbol, 'stop_loss'))
                continue
            
            # 检查止盈
            if self.take_profit_pct and position.pnl_pct >= self.take_profit_pct:
                positions_to_close.append((symbol, 'take_profit'))
                continue
            
            # 检查移动止损
            if self.trailing_stop_pct:
                drawdown_from_high = (position.highest_price - current_price) / position.highest_price
                if drawdown_from_high >= self.trailing_stop_pct:
                    positions_to_close.append((symbol, 'trailing_stop'))
        
        # 执行卖出
        for symbol, reason in positions_to_close:
            self._execute_sell(symbol, daily_data, date, reason)
    
    def _generate_signals(
        self,
        strategy: Dict,
        daily_data: pd.DataFrame,
        signal_type: str,
        date: datetime,
    ) -> List[Dict]:
        """生成交易信号"""
        signals = []
        
        if signal_type == 'entry':
            rules = strategy.get('entry_rules', [])
        else:
            rules = strategy.get('exit_rules', [])
        
        if not rules:
            return signals
        
        # 对每只股票检查规则
        for symbol in daily_data['symbol'].unique():
            stock_data = daily_data[daily_data['symbol'] == symbol]
            
            if stock_data.empty:
                continue
            
            # 检查所有入场规则
            all_conditions_met = True
            for rule in rules:
                if not self._check_condition(rule, stock_data, strategy.get('indicators', [])):
                    all_conditions_met = False
                    break
            
            if all_conditions_met:
                signals.append({
                    'symbol': symbol,
                    'price': stock_data['close'].iloc[0],
                    'date': date,
                    'reason': 'entry_rule',
                })
        
        return signals
    
    def _check_condition(
        self,
        rule: Dict,
        stock_data: pd.DataFrame,
        indicators: List[Dict],
    ) -> bool:
        """检查条件是否满足"""
        # 简化实现：这里应该解析条件表达式
        # 实际实现需要支持复杂的条件表达式
        
        condition = rule.get('condition', '')
        
        # TODO: 实现完整的条件解析
        # 目前返回随机结果用于测试
        import random
        return random.random() < 0.1  # 10%概率触发信号
    
    def _execute_buy(
        self,
        signal: Dict,
        daily_data: pd.DataFrame,
        date: datetime,
    ):
        """执行买入"""
        symbol = signal['symbol']
        price = signal['price']
        
        # 检查持仓数量限制
        if len(self.positions) >= self.max_positions:
            return
        
        # 检查是否已持有
        if symbol in self.positions:
            return
        
        # 计算买入金额
        available_cash = self.cash * self.max_single_position_pct
        commission = available_cash * self.commission_rate
        slippage_cost = available_cash * self.slippage_rate
        total_cost = available_cash + commission + slippage_cost
        
        if total_cost > self.cash:
            return
        
        # 执行买入
        quantity = int(available_cash / price / 100) * 100  # 按手买入
        if quantity == 0:
            return
        
        actual_amount = quantity * price
        actual_commission = actual_amount * self.commission_rate
        actual_slippage = actual_amount * self.slippage_rate
        
        # 更新持仓
        self.positions[symbol] = Position(
            symbol=symbol,
            quantity=quantity,
            avg_price=price,
            current_price=price,
            market_value=actual_amount,
            pnl=0.0,
            pnl_pct=0.0,
            open_time=date,
            highest_price=price,
        )
        
        # 更新现金
        self.cash -= (actual_amount + actual_commission + actual_slippage)
        
        # 记录交易
        trade = Trade(
            trade_id=f"{date.strftime('%Y%m%d')}_{symbol}_BUY",
            symbol=symbol,
            direction='buy',
            price=price,
            quantity=quantity,
            amount=actual_amount,
            timestamp=date,
            commission=actual_commission,
            slippage=actual_slippage,
            reason=signal.get('reason', 'entry'),
        )
        self.trades.append(trade)
        
        logger.debug(f"买入: {symbol} {quantity}股 @ {price:.2f}")
    
    def _execute_sell(
        self,
        symbol: str,
        daily_data: pd.DataFrame,
        date: datetime,
        reason: str,
    ):
        """执行卖出"""
        if symbol not in self.positions:
            return
        
        position = self.positions[symbol]
        
        # 获取当前价格
        stock_data = daily_data[daily_data['symbol'] == symbol]
        if stock_data.empty:
            return
        
        price = stock_data['close'].iloc[0]
        
        # 计算卖出金额
        amount = position.quantity * price
        commission = amount * self.commission_rate
        stamp_duty = amount * self.stamp_duty
        slippage = amount * self.slippage_rate
        
        # 计算盈亏
        pnl = (price - position.avg_price) * position.quantity - commission - stamp_duty - slippage
        
        # 更新现金
        self.cash += (amount - commission - stamp_duty - slippage)
        
        # 更新日内盈亏
        self.daily_pnl += pnl
        
        # 记录交易
        trade = Trade(
            trade_id=f"{date.strftime('%Y%m%d')}_{symbol}_SELL",
            symbol=symbol,
            direction='sell',
            price=price,
            quantity=position.quantity,
            amount=amount,
            timestamp=date,
            commission=commission,
            slippage=slippage,
            reason=reason,
            pnl=pnl,
        )
        self.trades.append(trade)
        
        # 移除持仓
        del self.positions[symbol]
        
        logger.debug(f"卖出: {symbol} {position.quantity}股 @ {price:.2f}, 原因: {reason}, 盈亏: {pnl:.2f}")
    
    def _update_equity(self, daily_data: pd.DataFrame, date: datetime):
        """更新净值"""
        total_equity = self._calculate_equity(daily_data)
        
        self.equity_curve.append({
            'date': date.isoformat(),
            'equity': total_equity,
            'cash': self.cash,
            'position_value': total_equity - self.cash,
        })
    
    def _calculate_equity(self, daily_data: pd.DataFrame) -> float:
        """计算总资产"""
        position_value = 0.0
        
        for symbol, position in self.positions.items():
            stock_data = daily_data[daily_data['symbol'] == symbol]
            if not stock_data.empty:
                current_price = stock_data['close'].iloc[0]
                position_value += position.quantity * current_price
        
        return self.cash + position_value
    
    def _calculate_performance(
        self,
        strategy: Dict,
        start_date: datetime,
        end_date: datetime,
    ) -> BacktestResult:
        """计算绩效指标"""
        
        # 基础指标
        final_capital = self.equity_curve[-1]['equity'] if self.equity_curve else self.initial_capital
        total_return = (final_capital - self.initial_capital) / self.initial_capital if self.initial_capital > 0 else 0
        
        # 年化收益率
        days = (end_date - start_date).days
        years = max(days / 365, 1) if days > 0 else 1
        annual_return = (1 + total_return) ** (1 / years) - 1 if total_return != 0 else 0
        
        # 构建资金曲线DataFrame
        if self.equity_curve:
            equity_df = pd.DataFrame(self.equity_curve)
            equity_df['date'] = pd.to_datetime(equity_df['date'])
            equity_df = equity_df.set_index('date')
        else:
            # 如果没有资金曲线，创建一个空的DataFrame
            equity_df = pd.DataFrame({'equity': [self.initial_capital]}, index=[start_date])
        
        # 计算回撤
        equity_df['peak'] = equity_df['equity'].cummax()
        equity_df['drawdown'] = (equity_df['equity'] - equity_df['peak']) / equity_df['peak']
        max_drawdown = equity_df['drawdown'].min() if len(equity_df) > 0 else 0
        
        # 波动率
        if len(equity_df) > 1:
            equity_df['returns'] = equity_df['equity'].pct_change()
            volatility = equity_df['returns'].std() * np.sqrt(252)  # 年化
        else:
            volatility = 0
        
        # 夏普比率
        risk_free_rate = 0.03  # 无风险利率
        sharpe_ratio = (annual_return - risk_free_rate) / volatility if volatility > 0 else 0
        
        # 索提诺比率
        downside_returns = equity_df['returns'][equity_df['returns'] < 0]
        downside_std = downside_returns.std() * np.sqrt(252)
        sortino_ratio = (annual_return - risk_free_rate) / downside_std if downside_std > 0 else 0
        
        # 卡玛比率
        calmar_ratio = annual_return / abs(max_drawdown) if max_drawdown != 0 else 0
        
        # 交易统计
        buy_trades = [t for t in self.trades if t.direction == 'buy']
        sell_trades = [t for t in self.trades if t.direction == 'sell']
        
        winning_trades = [t for t in sell_trades if t.pnl > 0]
        losing_trades = [t for t in sell_trades if t.pnl <= 0]
        
        total_trades = len(sell_trades)
        win_rate = len(winning_trades) / total_trades if total_trades > 0 else 0
        
        avg_win = np.mean([t.pnl for t in winning_trades]) if winning_trades else 0
        avg_loss = np.mean([t.pnl for t in losing_trades]) if losing_trades else 0
        
        total_profit = sum([t.pnl for t in winning_trades])
        total_loss = abs(sum([t.pnl for t in losing_trades]))
        profit_factor = total_profit / total_loss if total_loss > 0 else 0
        
        # 最大连续盈利/亏损
        max_consecutive_wins = self._calculate_max_consecutive(sell_trades, True)
        max_consecutive_losses = self._calculate_max_consecutive(sell_trades, False)
        
        # 平均持仓天数
        holding_days = []
        for buy_trade in buy_trades:
            # 找到对应的卖出交易
            for sell_trade in sell_trades:
                if sell_trade.symbol == buy_trade.symbol and sell_trade.timestamp > buy_trade.timestamp:
                    days = (sell_trade.timestamp - buy_trade.timestamp).days
                    holding_days.append(days)
                    break
        
        avg_holding_days = np.mean(holding_days) if holding_days else 0
        
        return BacktestResult(
            job_id='',  # 由调用者设置
            strategy_id=strategy.get('id', ''),
            strategy_name=strategy.get('name', ''),
            start_date=start_date,
            end_date=end_date,
            initial_capital=self.initial_capital,
            final_capital=final_capital,
            total_return=total_return,
            annual_return=annual_return,
            benchmark_return=0.0,  # TODO: 计算基准收益
            max_drawdown=max_drawdown,
            max_drawdown_duration=0,  # TODO: 计算
            volatility=volatility,
            sharpe_ratio=sharpe_ratio,
            sortino_ratio=sortino_ratio,
            calmar_ratio=calmar_ratio,
            total_trades=total_trades,
            winning_trades=len(winning_trades),
            losing_trades=len(losing_trades),
            win_rate=win_rate,
            avg_win=avg_win,
            avg_loss=avg_loss,
            profit_factor=profit_factor,
            max_consecutive_wins=max_consecutive_wins,
            max_consecutive_losses=max_consecutive_losses,
            avg_holding_days=avg_holding_days,
            max_positions=len(self.positions),
            equity_curve=self.equity_curve,
            drawdown_curve=equity_df[['drawdown']].reset_index().to_dict('records'),
            trade_list=[{
                'trade_id': t.trade_id,
                'symbol': t.symbol,
                'direction': t.direction,
                'price': t.price,
                'quantity': t.quantity,
                'amount': t.amount,
                'timestamp': t.timestamp.isoformat(),
                'pnl': t.pnl,
                'reason': t.reason,
            } for t in self.trades],
        )
    
    def _calculate_max_consecutive(self, trades: List[Trade], is_win: bool) -> int:
        """计算最大连续次数"""
        max_count = 0
        current_count = 0
        
        for trade in trades:
            if (is_win and trade.pnl > 0) or (not is_win and trade.pnl <= 0):
                current_count += 1
                max_count = max(max_count, current_count)
            else:
                current_count = 0
        
        return max_count
