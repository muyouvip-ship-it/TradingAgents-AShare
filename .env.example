# --- 核心模型接入 (Core LLM) ---
# 建议统一使用 TA_ 前缀，同时也兼容 OPENAI_API_KEY / OPENAI_BASE_URL
TA_API_KEY=
TA_BASE_URL=https://api.openai.com/v1
TA_LLM_PROVIDER=openai

# 模型名配置 (默认已提供常用值)
TA_LLM_QUICK=gpt-4o-mini
TA_LLM_DEEP=gpt-4o

# --- 安全密钥 (Security) ---
# 用于加密用户 API Key 和签发 JWT，生产环境必须设置！
# 生成方式: openssl rand -base64 32
# 首次设置时，系统会自动将已有数据从默认密钥迁移到新密钥。
# TA_APP_SECRET_KEY=

# --- 进阶可选配置 (Advanced Optional) ---
# 提示词语言 (auto / zh / en)，默认 zh
# TA_LANGUAGE=zh

# 运行日志追踪 (1 开启 / 0 关闭)，默认 1
# TA_TRACE=1

# 辩论与风险讨论轮数 (1-5)，默认 1
# TA_MAX_DEBATE=1
# TA_MAX_RISK=1

# --- VLM 截图识别 (Vision Language Model) ---
# 用于持仓截图识别，默认使用智谱 glm-4.6v-flash（免费）
# TA_VLM_API_KEY=你的智谱API Key
# TA_VLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# TA_VLM_MODEL=glm-4.6v-flash

# --- 邮件服务 (Email/SMTP) ---
# 仅在需要开启邮箱验证码登录时配置
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=465
# MAIL_USER=你的邮箱
# MAIL_PASS=你的授权码
# MAIL_FROM=发件人名称
# MAIL_SSL=1

# --- QMT 虚拟仓 (XtQuant / 极简模式) ---
# 启用后可在“虚拟仓”页面读取 QMT 模拟账户资产与持仓
# 注意：xtquant 交易接口通常需要运行在装有 QMT/miniQMT 的环境中，
# 并提供 userdata_mini 路径；仅有 192.168.10.1:58610 行情端口通常不足以直接读取交易资产。
# QMT_ENABLED=1
# QMT_HOST=192.168.10.1
# QMT_PORT=58610
# QMT_ACCOUNT_ID=你的证券账号
# QMT_ACCOUNT_TYPE=STOCK
# QMT_ACCOUNT_NAME=QMT 模拟账户
# QMT_USERDATA_PATH=C:/国金QMT交易端/userdata_mini
# QMT_REFRESH_INTERVAL_SECONDS=10
# QMT_DEFAULT_ACCOUNT_KEY=paper_sim
# QMT_BRIDGE_BASE_URL=http://192.168.10.1:8710
# QMT_BRIDGE_TOKEN=your-bridge-token
# QMT_ACCOUNTS_JSON=[{"key":"paper_sim","enabled":true,"role":"paper","host":"192.168.10.1","port":58610,"account_id":"39027628","account_type":"STOCK","account_name":"国金QMT模拟仓","userdata_path":"D:/国金QMT交易端模拟/userdata_mini","bridge_base_url":"http://192.168.10.1:8710","bridge_token":"your-bridge-token"},{"key":"live_real","enabled":true,"role":"live","host":"192.168.10.1","port":58610,"account_id":"8886186680","account_type":"STOCK","account_name":"国金QMT实盘仓","userdata_path":"D:/国金证券QMT交易端/userdata_mini","bridge_base_url":"http://192.168.10.1:8711","bridge_token":"your-bridge-token"}]

# 兼容说明: 系统自动识别 TA_ 前缀变量。
# 若需修改默认行为，取消上述注释并填值即可。
