import { useState, useEffect } from 'react'
import {
  ChartBarIcon,
  PlayIcon,
  PauseIcon,
  CogIcon,
  ArrowTrendingUpIcon,
  ShieldCheckIcon,
  BeakerIcon,
  DocumentChartBarIcon,
} from '@heroicons/react/24/outline'
import { ArrowPathIcon } from '@heroicons/react/24/solid'

interface Strategy {
  id: string
  name: string
  type: 'selection' | 'trading' | 'risk' | 'portfolio'
  description: string
  isActive: boolean
  parameters: Record<string, any>
  performance?: {
    totalReturn: number
    sharpeRatio: number
    maxDrawdown: number
    winRate: number
  }
  lastRunTime?: string
  runCount: number
}

interface BacktestResult {
  strategy: string
  startDate: string
  endDate: string
  initialCapital: number
  finalCapital: number
  metrics: {
    totalReturn: number
    annualReturn: number
    sharpeRatio: number
    maxDrawdown: number
    winRate: number
    profitFactor: number
  }
}

// 模拟策略数据
const mockStrategies: Strategy[] = [
  {
    id: 'value_investing',
    name: '价值投资策略',
    type: 'selection',
    description: '基于基本面指标的选股策略，筛选低估值、高质量的股票',
    isActive: true,
    parameters: {
      pe_threshold: null,
      pb_threshold: 1.5,
      roe_threshold: 0.15,
      dividend_yield_threshold: 0.03,
      debt_ratio_threshold: 0.6,
      max_stocks: 20,
    },
    performance: {
      totalReturn: 0.156,
      sharpeRatio: 1.82,
      maxDrawdown: -0.12,
      winRate: 0.65,
    },
    lastRunTime: '2026-04-16 09:30:00',
    runCount: 156,
  },
  {
    id: 'growth_investing',
    name: '成长投资策略',
    type: 'selection',
    description: '基于成长指标的选股策略，筛选高增长的优质公司',
    isActive: false,
    parameters: {
      revenue_growth_threshold: 0.2,
      profit_growth_threshold: 0.25,
      peg_threshold: 1.5,
      gross_margin_threshold: 0.3,
      max_stocks: 20,
    },
    performance: {
      totalReturn: 0.234,
      sharpeRatio: 2.15,
      maxDrawdown: -0.18,
      winRate: 0.58,
    },
    lastRunTime: '2026-04-15 15:00:00',
    runCount: 89,
  },
  {
    id: 'ma_cross',
    name: '均线交叉策略',
    type: 'trading',
    description: '基于快慢均线交叉的趋势跟踪策略，金叉买入，死叉卖出',
    isActive: true,
    parameters: {
      fast_period: 5,
      slow_period: 20,
      volume_threshold: 1.5,
    },
    performance: {
      totalReturn: 0.089,
      sharpeRatio: 1.45,
      maxDrawdown: -0.08,
      winRate: 0.72,
    },
    lastRunTime: '2026-04-16 14:30:00',
    runCount: 234,
  },
  {
    id: 'turtle_trading',
    name: '海龟交易策略',
    type: 'trading',
    description: '经典趋势突破策略，突破20日高点买入，跌破10日低点卖出',
    isActive: false,
    parameters: {
      entry_window: 20,
      exit_window: 10,
      atr_period: 14,
      atr_multiplier: 2.0,
      position_size_pct: 0.02,
    },
    performance: {
      totalReturn: 0.312,
      sharpeRatio: 2.45,
      maxDrawdown: -0.22,
      winRate: 0.48,
    },
    lastRunTime: '2026-04-14 10:15:00',
    runCount: 67,
  },
  {
    id: 'kelly_criterion',
    name: '凯利公式仓位管理',
    type: 'risk',
    description: '基于凯利公式的动态仓位管理策略，优化风险调整收益',
    isActive: true,
    parameters: {
      kelly_fraction: 0.5,
      max_position: 0.2,
    },
    performance: {
      totalReturn: 0.178,
      sharpeRatio: 2.05,
      maxDrawdown: -0.09,
      winRate: 0.68,
    },
    lastRunTime: '2026-04-16 09:35:00',
    runCount: 312,
  },
  {
    id: 'risk_parity',
    name: '风险平价策略',
    type: 'portfolio',
    description: '资产配置策略，使每个资产的风险贡献相等',
    isActive: false,
    parameters: {
      rebalance_frequency: 'monthly',
      risk_target: 0.1,
    },
    performance: {
      totalReturn: 0.098,
      sharpeRatio: 1.65,
      maxDrawdown: -0.06,
      winRate: 0.62,
    },
    lastRunTime: '2026-04-01 00:00:00',
    runCount: 12,
  },
]

const strategyTypeConfig = {
  selection: {
    label: '选股策略',
    icon: DocumentChartBarIcon,
    color: 'blue',
    bgColor: 'bg-blue-50',
    textColor: 'text-blue-700',
    borderColor: 'border-blue-200',
  },
  trading: {
    label: '交易策略',
    icon: ArrowTrendingUpIcon,
    color: 'green',
    bgColor: 'bg-green-50',
    textColor: 'text-green-700',
    borderColor: 'border-green-200',
  },
  risk: {
    label: '风控策略',
    icon: ShieldCheckIcon,
    color: 'yellow',
    bgColor: 'bg-yellow-50',
    textColor: 'text-yellow-700',
    borderColor: 'border-yellow-200',
  },
  portfolio: {
    label: '组合策略',
    icon: ChartBarIcon,
    color: 'purple',
    bgColor: 'bg-purple-50',
    textColor: 'text-purple-700',
    borderColor: 'border-purple-200',
  },
}

export default function Strategies() {
  const [strategies, setStrategies] = useState<Strategy[]>([])
  const [selectedStrategy, setSelectedStrategy] = useState<Strategy | null>(null)
  const [activeTab, setActiveTab] = useState<'overview' | 'config' | 'backtest'>('overview')
  const [filterType, setFilterType] = useState<string>('all')
  const [showBacktestModal, setShowBacktestModal] = useState(false)
  const [backtestResult, setBacktestResult] = useState<BacktestResult | null>(null)
  const [isRunningBacktest, setIsRunningBacktest] = useState(false)

  useEffect(() => {
    // 加载策略数据
    setStrategies(mockStrategies)
  }, [])

  const handleToggleStrategy = (strategyId: string) => {
    setStrategies(prev =>
      prev.map(s =>
        s.id === strategyId ? { ...s, isActive: !s.isActive } : s
      )
    )
  }

  const handleUpdateParameters = (strategyId: string, newParams: Record<string, any>) => {
    setStrategies(prev =>
      prev.map(s =>
        s.id === strategyId ? { ...s, parameters: newParams } : s
      )
    )
    if (selectedStrategy?.id === strategyId) {
      setSelectedStrategy(prev => prev ? { ...prev, parameters: newParams } : null)
    }
  }

  const handleRunBacktest = async () => {
    if (!selectedStrategy) return

    setIsRunningBacktest(true)

    // 模拟回测
    await new Promise(resolve => setTimeout(resolve, 2000))

    const mockResult: BacktestResult = {
      strategy: selectedStrategy.name,
      startDate: '2023-01-01',
      endDate: '2023-12-31',
      initialCapital: 1000000,
      finalCapital: 1156000,
      metrics: {
        totalReturn: 0.156,
        annualReturn: 0.156,
        sharpeRatio: 1.82,
        maxDrawdown: -0.12,
        winRate: 0.65,
        profitFactor: 1.85,
      },
    }

    setBacktestResult(mockResult)
    setIsRunningBacktest(false)
  }

  const filteredStrategies = strategies.filter(
    s => filterType === 'all' || s.type === filterType
  )

  const activeCount = strategies.filter(s => s.isActive).length

  return (
    <div className="min-h-screen bg-slate-50 p-6">
      {/* 页面标题 */}
      <div className="mb-6">
        <h1 className="text-2xl font-bold text-slate-900">策略管理</h1>
        <p className="text-slate-600 mt-1">管理和优化您的量化交易策略</p>
      </div>

      {/* 统计卡片 */}
      <div className="grid grid-cols-1 md:grid-cols-4 gap-4 mb-6">
        <div className="bg-white rounded-lg shadow p-4">
          <div className="flex items-center justify-between">
            <div>
              <p className="text-sm text-slate-500">总策略数</p>
              <p className="text-2xl font-bold text-slate-900">{strategies.length}</p>
            </div>
            <div className="h-12 w-12 bg-blue-100 rounded-full flex items-center justify-center">
              <ChartBarIcon className="h-6 w-6 text-blue-600" />
            </div>
          </div>
        </div>

        <div className="bg-white rounded-lg shadow p-4">
          <div className="flex items-center justify-between">
            <div>
              <p className="text-sm text-slate-500">活跃策略</p>
              <p className="text-2xl font-bold text-green-600">{activeCount}</p>
            </div>
            <div className="h-12 w-12 bg-green-100 rounded-full flex items-center justify-center">
              <PlayIcon className="h-6 w-6 text-green-600" />
            </div>
          </div>
        </div>

        <div className="bg-white rounded-lg shadow p-4">
          <div className="flex items-center justify-between">
            <div>
              <p className="text-sm text-slate-500">平均夏普比率</p>
              <p className="text-2xl font-bold text-slate-900">1.92</p>
            </div>
            <div className="h-12 w-12 bg-purple-100 rounded-full flex items-center justify-center">
              <ArrowTrendingUpIcon className="h-6 w-6 text-purple-600" />
            </div>
          </div>
        </div>

        <div className="bg-white rounded-lg shadow p-4">
          <div className="flex items-center justify-between">
            <div>
              <p className="text-sm text-slate-500">平均最大回撤</p>
              <p className="text-2xl font-bold text-red-600">-12.5%</p>
            </div>
            <div className="h-12 w-12 bg-red-100 rounded-full flex items-center justify-center">
              <ShieldCheckIcon className="h-6 w-6 text-red-600" />
            </div>
          </div>
        </div>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
        {/* 策略列表 */}
        <div className="lg:col-span-1">
          <div className="bg-white rounded-lg shadow">
            <div className="p-4 border-b border-slate-200">
              <div className="flex items-center justify-between mb-3">
                <h2 className="text-lg font-semibold text-slate-900">策略列表</h2>
              </div>

              {/* 筛选器 */}
              <div className="flex gap-2">
                <button
                  onClick={() => setFilterType('all')}
                  className={`px-3 py-1.5 text-sm rounded-md transition ${
                    filterType === 'all'
                      ? 'bg-slate-900 text-white'
                      : 'bg-slate-100 text-slate-600 hover:bg-slate-200'
                  }`}
                >
                  全部
                </button>
                {Object.entries(strategyTypeConfig).map(([type, config]) => (
                  <button
                    key={type}
                    onClick={() => setFilterType(type)}
                    className={`px-3 py-1.5 text-sm rounded-md transition ${
                      filterType === type
                        ? 'bg-slate-900 text-white'
                        : 'bg-slate-100 text-slate-600 hover:bg-slate-200'
                    }`}
                  >
                    {config.label}
                  </button>
                ))}
              </div>
            </div>

            <div className="divide-y divide-slate-200 max-h-[600px] overflow-y-auto">
              {filteredStrategies.map(strategy => {
                const config = strategyTypeConfig[strategy.type]
                const Icon = config.icon

                return (
                  <button
                    key={strategy.id}
                    onClick={() => {
                      setSelectedStrategy(strategy)
                      setActiveTab('overview')
                    }}
                    className={`w-full p-4 text-left hover:bg-slate-50 transition ${
                      selectedStrategy?.id === strategy.id ? 'bg-blue-50' : ''
                    }`}
                  >
                    <div className="flex items-start justify-between">
                      <div className="flex-1">
                        <div className="flex items-center gap-2 mb-1">
                          <div className={`h-8 w-8 ${config.bgColor} rounded-lg flex items-center justify-center`}>
                            <Icon className={`h-4 w-4 ${config.textColor}`} />
                          </div>
                          <div className="flex-1">
                            <h3 className="font-medium text-slate-900">{strategy.name}</h3>
                            <p className="text-xs text-slate-500">{config.label}</p>
                          </div>
                        </div>
                        <p className="text-sm text-slate-600 mt-2 line-clamp-2">{strategy.description}</p>
                      </div>
                      <div className="ml-2">
                        {strategy.isActive ? (
                          <span className="inline-flex items-center gap-1 px-2 py-1 bg-green-100 text-green-700 text-xs rounded-full">
                            <span className="h-1.5 w-1.5 bg-green-600 rounded-full animate-pulse"></span>
                            运行中
                          </span>
                        ) : (
                          <span className="inline-flex items-center px-2 py-1 bg-slate-100 text-slate-600 text-xs rounded-full">
                            已停用
                          </span>
                        )}
                      </div>
                    </div>

                    {strategy.performance && (
                      <div className="flex gap-4 mt-3 text-xs">
                        <div>
                          <span className="text-slate-500">收益</span>
                          <span className={`ml-1 font-medium ${strategy.performance.totalReturn >= 0 ? 'text-green-600' : 'text-red-600'}`}>
                            {(strategy.performance.totalReturn * 100).toFixed(1)}%
                          </span>
                        </div>
                        <div>
                          <span className="text-slate-500">夏普</span>
                          <span className="ml-1 font-medium text-slate-900">{strategy.performance.sharpeRatio.toFixed(2)}</span>
                        </div>
                        <div>
                          <span className="text-slate-500">胜率</span>
                          <span className="ml-1 font-medium text-slate-900">{(strategy.performance.winRate * 100).toFixed(0)}%</span>
                        </div>
                      </div>
                    )}
                  </button>
                )
              })}
            </div>
          </div>
        </div>

        {/* 策略详情 */}
        <div className="lg:col-span-2">
          {selectedStrategy ? (
            <div className="bg-white rounded-lg shadow">
              {/* 标签页 */}
              <div className="border-b border-slate-200">
                <div className="flex">
                  <button
                    onClick={() => setActiveTab('overview')}
                    className={`px-6 py-4 text-sm font-medium border-b-2 transition ${
                      activeTab === 'overview'
                        ? 'border-blue-600 text-blue-600'
                        : 'border-transparent text-slate-500 hover:text-slate-700'
                    }`}
                  >
                    概览
                  </button>
                  <button
                    onClick={() => setActiveTab('config')}
                    className={`px-6 py-4 text-sm font-medium border-b-2 transition ${
                      activeTab === 'config'
                        ? 'border-blue-600 text-blue-600'
                        : 'border-transparent text-slate-500 hover:text-slate-700'
                    }`}
                  >
                    参数配置
                  </button>
                  <button
                    onClick={() => setActiveTab('backtest')}
                    className={`px-6 py-4 text-sm font-medium border-b-2 transition ${
                      activeTab === 'backtest'
                        ? 'border-blue-600 text-blue-600'
                        : 'border-transparent text-slate-500 hover:text-slate-700'
                    }`}
                  >
                    回测
                  </button>
                </div>
              </div>

              <div className="p-6">
                {/* 概览 */}
                {activeTab === 'overview' && (
                  <div>
                    <div className="flex items-start justify-between mb-6">
                      <div>
                        <h2 className="text-xl font-bold text-slate-900">{selectedStrategy.name}</h2>
                        <p className="text-slate-600 mt-1">{selectedStrategy.description}</p>
                      </div>
                      <button
                        onClick={() => handleToggleStrategy(selectedStrategy.id)}
                        className={`flex items-center gap-2 px-4 py-2 rounded-lg font-medium transition ${
                          selectedStrategy.isActive
                            ? 'bg-red-50 text-red-600 hover:bg-red-100'
                            : 'bg-green-50 text-green-600 hover:bg-green-100'
                        }`}
                      >
                        {selectedStrategy.isActive ? (
                          <>
                            <PauseIcon className="h-4 w-4" />
                            停用策略
                          </>
                        ) : (
                          <>
                            <PlayIcon className="h-4 w-4" />
                            启用策略
                          </>
                        )}
                      </button>
                    </div>

                    {/* 性能指标 */}
                    {selectedStrategy.performance && (
                      <div className="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
                        <div className="bg-gradient-to-br from-blue-50 to-blue-100 rounded-lg p-4">
                          <p className="text-sm text-blue-600 mb-1">总收益率</p>
                          <p className={`text-2xl font-bold ${selectedStrategy.performance.totalReturn >= 0 ? 'text-green-600' : 'text-red-600'}`}>
                            {(selectedStrategy.performance.totalReturn * 100).toFixed(1)}%
                          </p>
                        </div>
                        <div className="bg-gradient-to-br from-purple-50 to-purple-100 rounded-lg p-4">
                          <p className="text-sm text-purple-600 mb-1">夏普比率</p>
                          <p className="text-2xl font-bold text-slate-900">{selectedStrategy.performance.sharpeRatio.toFixed(2)}</p>
                        </div>
                        <div className="bg-gradient-to-br from-red-50 to-red-100 rounded-lg p-4">
                          <p className="text-sm text-red-600 mb-1">最大回撤</p>
                          <p className="text-2xl font-bold text-red-600">{(selectedStrategy.performance.maxDrawdown * 100).toFixed(1)}%</p>
                        </div>
                        <div className="bg-gradient-to-br from-green-50 to-green-100 rounded-lg p-4">
                          <p className="text-sm text-green-600 mb-1">胜率</p>
                          <p className="text-2xl font-bold text-slate-900">{(selectedStrategy.performance.winRate * 100).toFixed(0)}%</p>
                        </div>
                      </div>
                    )}

                    {/* 基本信息 */}
                    <div className="bg-slate-50 rounded-lg p-4">
                      <h3 className="font-semibold text-slate-900 mb-3">基本信息</h3>
                      <div className="grid grid-cols-2 gap-4 text-sm">
                        <div>
                          <span className="text-slate-500">策略ID:</span>
                          <span className="ml-2 font-mono text-slate-900">{selectedStrategy.id}</span>
                        </div>
                        <div>
                          <span className="text-slate-500">策略类型:</span>
                          <span className="ml-2 text-slate-900">{strategyTypeConfig[selectedStrategy.type].label}</span>
                        </div>
                        <div>
                          <span className="text-slate-500">运行次数:</span>
                          <span className="ml-2 text-slate-900">{selectedStrategy.runCount} 次</span>
                        </div>
                        <div>
                          <span className="text-slate-500">最后运行:</span>
                          <span className="ml-2 text-slate-900">{selectedStrategy.lastRunTime || '未运行'}</span>
                        </div>
                      </div>
                    </div>
                  </div>
                )}

                {/* 参数配置 */}
                {activeTab === 'config' && (
                  <div>
                    <div className="flex items-center justify-between mb-4">
                      <h3 className="text-lg font-semibold text-slate-900">策略参数</h3>
                      <button className="text-sm text-blue-600 hover:text-blue-700">
                        重置为默认值
                      </button>
                    </div>

                    <div className="space-y-4">
                      {Object.entries(selectedStrategy.parameters).map(([key, value]) => (
                        <div key={key} className="flex items-center gap-4">
                          <label className="w-40 text-sm font-medium text-slate-700">
                            {key.replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase())}
                          </label>
                          <input
                            type={typeof value === 'number' ? 'number' : 'text'}
                            value={value ?? ''}
                            onChange={(e) => {
                              const newValue = typeof value === 'number' 
                                ? parseFloat(e.target.value) 
                                : e.target.value
                              handleUpdateParameters(selectedStrategy.id, {
                                ...selectedStrategy.parameters,
                                [key]: newValue,
                              })
                            }}
                            className="flex-1 px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                            step={typeof value === 'number' ? '0.01' : undefined}
                          />
                          <span className="text-sm text-slate-500 w-20">
                            {typeof value === 'number' && value > 0 && value < 1 ? '(比例)' : ''}
                            {typeof value === 'number' && value >= 1 ? '(数值)' : ''}
                          </span>
                        </div>
                      ))}
                    </div>

                    <div className="mt-6 flex gap-3">
                      <button
                        onClick={() => {
                          // 保存参数逻辑
                          alert('参数已保存！')
                        }}
                        className="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition"
                      >
                        保存参数
                      </button>
                      <button
                        onClick={() => setActiveTab('backtest')}
                        className="px-4 py-2 bg-slate-100 text-slate-700 rounded-lg hover:bg-slate-200 transition"
                      >
                        运行回测验证
                      </button>
                    </div>
                  </div>
                )}

                {/* 回测 */}
                {activeTab === 'backtest' && (
                  <div>
                    <div className="flex items-center justify-between mb-6">
                      <h3 className="text-lg font-semibold text-slate-900">策略回测</h3>
                      <button
                        onClick={handleRunBacktest}
                        disabled={isRunningBacktest}
                        className="flex items-center gap-2 px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition disabled:opacity-50 disabled:cursor-not-allowed"
                      >
                        {isRunningBacktest ? (
                          <>
                            <ArrowPathIcon className="h-4 w-4 animate-spin" />
                            回测中...
                          </>
                        ) : (
                          <>
                            <BeakerIcon className="h-4 w-4" />
                            开始回测
                          </>
                        )}
                      </button>
                    </div>

                    {/* 回测配置 */}
                    <div className="grid grid-cols-3 gap-4 mb-6">
                      <div>
                        <label className="block text-sm font-medium text-slate-700 mb-1">开始日期</label>
                        <input
                          type="date"
                          defaultValue="2023-01-01"
                          className="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500"
                        />
                      </div>
                      <div>
                        <label className="block text-sm font-medium text-slate-700 mb-1">结束日期</label>
                        <input
                          type="date"
                          defaultValue="2023-12-31"
                          className="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500"
                        />
                      </div>
                      <div>
                        <label className="block text-sm font-medium text-slate-700 mb-1">初始资金</label>
                        <input
                          type="number"
                          defaultValue={1000000}
                          className="w-full px-3 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-blue-500"
                        />
                      </div>
                    </div>

                    {/* 回测结果 */}
                    {backtestResult && (
                      <div className="bg-gradient-to-br from-slate-50 to-slate-100 rounded-lg p-6">
                        <h4 className="font-semibold text-slate-900 mb-4">回测结果</h4>
                        
                        <div className="grid grid-cols-2 gap-6 mb-6">
                          <div>
                            <p className="text-sm text-slate-500 mb-1">初始资金</p>
                            <p className="text-xl font-bold text-slate-900">
                              ¥{backtestResult.initialCapital.toLocaleString()}
                            </p>
                          </div>
                          <div>
                            <p className="text-sm text-slate-500 mb-1">最终资金</p>
                            <p className="text-xl font-bold text-green-600">
                              ¥{backtestResult.finalCapital.toLocaleString()}
                            </p>
                          </div>
                        </div>

                        <div className="grid grid-cols-3 gap-4">
                          <div className="bg-white rounded-lg p-4 shadow-sm">
                            <p className="text-sm text-slate-500 mb-1">总收益率</p>
                            <p className={`text-2xl font-bold ${backtestResult.metrics.totalReturn >= 0 ? 'text-green-600' : 'text-red-600'}`}>
                              {(backtestResult.metrics.totalReturn * 100).toFixed(1)}%
                            </p>
                          </div>
                          <div className="bg-white rounded-lg p-4 shadow-sm">
                            <p className="text-sm text-slate-500 mb-1">夏普比率</p>
                            <p className="text-2xl font-bold text-slate-900">
                              {backtestResult.metrics.sharpeRatio.toFixed(2)}
                            </p>
                          </div>
                          <div className="bg-white rounded-lg p-4 shadow-sm">
                            <p className="text-sm text-slate-500 mb-1">最大回撤</p>
                            <p className="text-2xl font-bold text-red-600">
                              {(backtestResult.metrics.maxDrawdown * 100).toFixed(1)}%
                            </p>
                          </div>
                          <div className="bg-white rounded-lg p-4 shadow-sm">
                            <p className="text-sm text-slate-500 mb-1">胜率</p>
                            <p className="text-2xl font-bold text-slate-900">
                              {(backtestResult.metrics.winRate * 100).toFixed(0)}%
                            </p>
                          </div>
                          <div className="bg-white rounded-lg p-4 shadow-sm">
                            <p className="text-sm text-slate-500 mb-1">盈利因子</p>
                            <p className="text-2xl font-bold text-slate-900">
                              {backtestResult.metrics.profitFactor.toFixed(2)}
                            </p>
                          </div>
                          <div className="bg-white rounded-lg p-4 shadow-sm">
                            <p className="text-sm text-slate-500 mb-1">年化收益</p>
                            <p className={`text-2xl font-bold ${backtestResult.metrics.annualReturn >= 0 ? 'text-green-600' : 'text-red-600'}`}>
                              {(backtestResult.metrics.annualReturn * 100).toFixed(1)}%
                            </p>
                          </div>
                        </div>
                      </div>
                    )}

                    {!backtestResult && !isRunningBacktest && (
                      <div className="text-center py-12 text-slate-500">
                        <BeakerIcon className="h-12 w-12 mx-auto mb-4 opacity-50" />
                        <p>点击"开始回测"按钮运行策略回测</p>
                      </div>
                    )}
                  </div>
                )}
              </div>
            </div>
          ) : (
            <div className="bg-white rounded-lg shadow p-12 text-center">
              <ChartBarIcon className="h-16 w-16 mx-auto text-slate-300 mb-4" />
              <h3 className="text-lg font-medium text-slate-900 mb-2">选择一个策略</h3>
              <p className="text-slate-500">从左侧列表中选择一个策略查看详情</p>
            </div>
          )}
        </div>
      </div>
    </div>
  )
}
